architecture-beta
    group client(cloud)[Client]
    service webui(server)[Svelte Frontend] in client

    group api(server)[Backend API]
    service fastapi(server)[FastAPI App] in api
    service v1(server)[V1 Routes] in api

    group services(server)[Application Services]
    service dialogorch(server)[Dialog Orchestrator] in services
    service importrunner(server)[Import Runner] in services
    service importsummary(server)[Import Summary Logger] in services
    service resourcemonitor(server)[Resource Monitor] in services
    service csvlogger(disk)[CSV Audit Logger] in services
    service sttclient(server)[Speech to Text Client] in services

    group pipeline(server)[NLP Pipeline]
    service pipelinecore(server)[Holiday Search Pipeline] in pipeline
    service language(server)[Language Detector] in pipeline
    service extractor(server)[Rules Extractor] in pipeline
    service llmextractor(server)[LLM Extractor] in pipeline
    service hybrid(server)[Hybrid Strategy] in pipeline
    service normalizer(server)[Normalizer] in pipeline
    service validator(server)[Validator] in pipeline
    service imputer(server)[Popularity Imputer] in pipeline

    group data(database)[Domain Data]
    service fixturesrepo(database)[Fixture Repository] in data
    service searchconfig(database)[Search Configuration] in data
    service methodsconfig(database)[Methods Catalogue] in data
    service popularity(database)[Popularity Stats] in data

    group integrations(cloud)[External Providers]
    service gemini(internet)[Google Gemini LLM] in integrations
    service llmgateway(internet)[HTTP LLM Endpoint] in integrations
    service deepgram(internet)[Deepgram Speech to Text] in integrations
    service whisper(server)[Local Faster Whisper] in integrations

    webui:R --> L:fastapi
    fastapi:B --> T:v1

    v1:R --> L:pipelinecore
    v1:R --> L:dialogorch
    v1:R --> L:importrunner
    v1:B --> T:csvlogger
    v1:B --> T:importsummary
    v1:R --> L:sttclient

    dialogorch:R --> L:pipelinecore
    dialogorch:B --> T:csvlogger

    importrunner:R --> L:pipelinecore
    importrunner:B --> T:resourcemonitor
    importrunner:B --> T:csvlogger
    importrunner:B --> T:importsummary

    sttclient:R --> L:deepgram
    sttclient:R --> L:whisper

    pipelinecore:R --> L:language
    pipelinecore:R --> L:extractor
    pipelinecore:R --> L:llmextractor
    pipelinecore:R --> L:hybrid
    pipelinecore:R --> L:normalizer
    pipelinecore:R --> L:validator
    pipelinecore:R --> L:imputer

    pipelinecore:B --> T:fixturesrepo
    pipelinecore:B --> T:searchconfig
    pipelinecore:B --> T:methodsconfig

    extractor:B --> T:fixturesrepo
    normalizer:B --> T:fixturesrepo
    validator:B --> T:fixturesrepo

    llmextractor:R --> L:gemini
    llmextractor:R --> L:llmgateway

    imputer:B --> T:popularity
