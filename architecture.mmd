architecture-beta
    group client(cloud)[Client]
    
    service webui(server)[Svelte Frontend] in client
    
    group api(server)[API Layer]

    service fastapi(server)[FastAPI Application] in api
    service health(server)[health] in api
    service parse(server)[parse] in api
    service dialog(server)[dialog] in api
    service voice(server)[voice] in api
    service fixtures(server)[fixtures] in api

    group pipeline(server)[NLP Pipeline]

    service orchestrator(server)[Pipeline Orchestrator] in pipeline
    service langdetect(server)[Language Detector] in pipeline
    service methodcatalog(server)[Method Catalogue] in pipeline
    service extractor(server)[Extractor Dispatcher] in pipeline
    service normalizer(server)[Normalizer] in pipeline
    service validator(server)[Validator] in pipeline
    service dialogorch(server)[Dialog Orchestrator] in pipeline

    group extraction(server)[Extraction Methods]

    service rules(server)[Rules Extractor] in extraction
    service llm(server)[LLM Extractor] in extraction
    service hybrid(server)[Hybrid Strategy] in extraction

    group services(server)[Supporting Services]

    service csvlogger(disk)[CSV Logger] in services
    service importrunner(server)[Import Job Runner] in services
    service importsummary(server)[Import Summary Reporter] in services
    service resourcemonitor(server)[Resource Monitor] in services
    service sttclient(server)[Speech to Text Client] in services

    group data(database)[Data and Fixtures]
    
    service fixturesrepo(database)[Fixture Repository] in data
    service popularity(database)[Popularity Stats] in data
    service methodsconfig(database)[Methods Configuration] in data

    group integrations(cloud)[External Providers]

    service openai(internet)[OpenAI API] in integrations
    service deepgram(internet)[Deepgram STT] in integrations
    service whisper(server)[Local Faster Whisper] in integrations
    service gemini(internet)[Google Gemini] in integrations

    webui:R --> L:fastapi

    fastapi:B --> T:health
    fastapi:B --> T:parse
    fastapi:B --> T:dialog
    fastapi:B --> T:voice
    fastapi:B --> T:fixtures

    parse:R --> L:orchestrator
    dialog:R --> L:dialogorch
    voice:R --> L:sttclient

    orchestrator:R --> L:langdetect
    orchestrator:R --> L:methodcatalog
    langdetect:R --> L:extractor
    extractor:R --> L:normalizer
    normalizer:R --> L:validator

    methodcatalog:B --> T:methodsconfig
    normalizer:B --> T:fixturesrepo
    validator:B --> T:fixturesrepo
    validator:B --> T:popularity

    extractor:B --> T:rules
    extractor:B --> T:llm
    extractor:B --> T:hybrid

    llm:R --> L:openai
    llm:R --> L:gemini
    sttclient:R --> L:deepgram
    sttclient:R --> L:whisper

    parse:B --> T:csvlogger
    dialog:B --> T:csvlogger
    voice:B --> T:csvlogger

    importrunner:R --> L:parse
    importrunner:R --> L:resourcemonitor
    importrunner:R --> L:importsummary
    importsummary:R --> L:csvlogger
