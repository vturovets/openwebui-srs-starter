```mermaid
architecture-beta
    title OpenWebUI AI Search

    group client(browser)[Client] {
        service webui(browser)[Svelte Frontend]
    }

    group api(server)[API Layer] {
        service fastapi(server)[FastAPI Application]
        service health(api)[/health]
        service parse(api)[/v1/parse]
        service dialog(api)[/v1/dialog]
        service voice(api)[/v1/voice]
        service fixtures(api)[/v1/fixtures]
    }

    group pipeline(server)[NLP Pipeline] {
        service orchestrator(service)[Pipeline Orchestrator]
        service langdetect(service)[Language Detector]
        service methodcatalog(service)[Method Catalogue]
        service extractor(service)[Extractor Dispatcher]
        service normalizer(service)[Normalizer]
        service validator(service)[Validator]
        service dialogorch(service)[Dialog Orchestrator]
    }

    group extraction(server)[Extraction Methods] {
        service rules(service)[Rules Extractor]
        service llm(service)[LLM Extractor]
        service hybrid(service)[Hybrid Strategy]
    }

    group services(server)[Supporting Services] {
        service csvlogger(storage)[CSV Logger]
        service importrunner(worker)[Import Job Runner]
        service importsummary(service)[Import Summary Reporter]
        service resourcemonitor(monitor)[Resource Monitor]
        service sttclient(service)[Speech-to-Text Client]
    }

    group data(database)[Data & Fixtures] {
        service fixturesrepo(storage)[Fixture Repository]
        service popularity(storage)[Popularity Stats]
        service methodsconfig(storage)[Methods Configuration]
    }

    group integrations(cloud)[External Providers] {
        service openai(internet)[OpenAI API]
        service deepgram(internet)[Deepgram STT]
        service whisper(cpu)[Local Faster-Whisper]
    }

    webui:R --> L:fastapi

    fastapi:B --> T:health
    fastapi:B --> T:parse
    fastapi:B --> T:dialog
    fastapi:B --> T:voice
    fastapi:B --> T:fixtures

    parse:R --> L:orchestrator
    dialog:R --> L:dialogorch
    voice:R --> L:sttclient

    orchestrator:R --> L:langdetect
    orchestrator:R --> L:methodcatalog
    langdetect:R --> L:extractor
    extractor:R --> L:normalizer
    normalizer:R --> L:validator

    methodcatalog:B --> T:methodsconfig
    normalizer:B --> T:fixturesrepo
    validator:B --> T:fixturesrepo
    validator:B --> T:popularity

    extractor:B --> T:rules
    extractor:B --> T:llm
    extractor:B --> T:hybrid

    llm:R --> L:openai
    sttclient:R --> L:deepgram
    sttclient:R --> L:whisper

    parse:B --> T:csvlogger
    dialog:B --> T:csvlogger
    voice:B --> T:csvlogger

    importrunner:R --> L:parse
    importrunner:R --> L:resourcemonitor
    importrunner:R --> L:importsummary
    importsummary:R --> L:csvlogger
```
