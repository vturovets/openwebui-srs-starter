architecture-beta
    group api(cloud)[API Layer]
    
    service fastapi(server)[FastAPI Backend] in api
    service health(internet)[Health Check] in api
    service parse(internet)[Parse Endpoint] in api
    service dialog(internet)[Dialog Endpoint] in api
    service voice(internet)[Voice Endpoint] in api
    service fixtures(internet)[Fixtures Endpoint] in api

    group frontend(cloud)[Frontend Layer]
    
    service svelte(disk)[Svelte SPA] in frontend
    service vite(disk)[Vite Build] in frontend

    group pipeline(server)[NLP Pipeline]
    
    service langdetect(disk)[Language Detector] in pipeline
    service extractor(disk)[Extractors] in pipeline
    service normalizer(disk)[Normalizer] in pipeline
    service validator(disk)[Validator] in pipeline
    service dialogorch(disk)[Dialog Orchestrator] in pipeline

    group extractors(server)[Extraction Methods]
    
    service rules(disk)[Rules Extractor] in extractors
    service llm(disk)[LLM Extractor] in extractors
    service hybrid(disk)[Hybrid Extractor] in extractors

    group integrations(cloud)[External Services]
    
    service openai(internet)[OpenAI API] in integrations
    service deepgram(internet)[Deepgram STT] in integrations
    service whisper(disk)[Faster Whisper] in integrations

    group data(database)[Data Layer]
    
    service csvlog(disk)[CSV Logger] in data
    service fixturedata(disk)[Fixture Repository] in data
    service popularity(disk)[Popularity Stats] in data

    group services(server)[Services]
    
    service importrunner(disk)[Import Job Runner] in services
    service resourcemon(disk)[Resource Monitor] in services
    service sttclient(disk)[STT Client] in services

    svelte:R --> L:fastapi
    fastapi:B --> T:health
    fastapi:B --> T:parse
    fastapi:B --> T:dialog
    fastapi:B --> T:voice
    fastapi:B --> T:fixtures

    parse:R --> L:langdetect
    dialog:R --> L:dialogorch
    voice:R --> L:sttclient

    langdetect:B --> T:extractor
    extractor:R --> L:normalizer
    normalizer:R --> L:validator

    extractor:B --> T:rules
    extractor:B --> T:llm
    extractor:B --> T:hybrid

    llm:R --> L:openai
    sttclient:R --> L:deepgram
    sttclient:R --> L:whisper

    parse:B --> T:csvlog
    dialog:B --> T:csvlog
    voice:B --> T:csvlog

    normalizer:B --> T:fixturedata
    validator:B --> T:fixturedata
    validator:B --> T:popularity

    parse:L --> R:importrunner
    importrunner:R --> L:resourcemon
