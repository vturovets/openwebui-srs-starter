```mermaid
flowchart TD
    %% Clients
    subgraph Client[Client]
        U[User]
        FE[Vite + Svelte Frontend]
        U --> FE
    end

    %% Backend
    subgraph Backend[FastAPI Backend]
        API[API Router\n/health, /v1/parse, /v1/dialog, /v1/fixtures, /v1/voice]
        DIALOG[Dialog Orchestrator\n(dialog.py)]
        PIPE[HolidaySearchPipeline\n(pipeline.py)]
        IMPORT[ImportJobRunner\n(import_runner.py)]
        LOGGER[CSVLogger\n(csv_logger.py)]
        STT[SpeechToTextClient\nDeepgram or faster-whisper]
    end

    %% Pipeline internals
    subgraph Pipeline[Structured NLP Pipeline]
        LANG[LanguageDetector\n(language.py)]
        EXTRACT{Extractor\nRules or LLM}
        NORM[Normalizer\n(normalizer.py)]
        IMPUTER[[PopularityImputer\n(popularity_imputer.py)]]
        VALID[Validator\n(validator.py)]
    end

    %% Fixtures and configuration
    subgraph DataSources[Fixtures & Configuration]
        FIXTURES[FixtureRepository\nAirports, destinations, dates]
        CONFIG[Search Configuration\nconfiguration_search.json]
        METHODS[Methods Catalog\nconfig/methods.yaml]
        POP_STATS[Popularity Stats\nfixtures/popularity_stats.json]
    end

    %% Flows
    FE -->|REST/JSON| API
    API -->|parse| PIPE
    API -->|dialog| DIALOG
    API -->|voice| STT
    STT -->|transcript| PIPE
    API -->|bulk import| IMPORT

    PIPE --> LANG --> EXTRACT --> NORM --> VALID
    EXTRACT -->|LLM latency| NORM
    NORM -->|optional| IMPUTER --> VALID
    VALID -->|structured payload + timings| API

    DIALOG --> PIPE
    IMPORT --> PIPE

    PIPE --> LOGGER
    DIALOG --> LOGGER
    API --> LOGGER

    %% Data dependencies
    PIPE <-.-> FIXTURES
    PIPE <-.-> CONFIG
    PIPE <-.-> METHODS
    IMPUTER <-.-> POP_STATS
```
